{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "playground",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "playground-node",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "apps/playground",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "sync-server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--experimental-transform-types",
        "--no-warnings",
        "--import",
        "./apps/sync-server/src/resolve.ts",
        "apps/sync-server/src/server.ts",
        "8787",
        "--data=.quire-data",
        "--idle=10000"
      ],
      "port": 8787
    },
    {
      "name": "example-vanilla",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "examples/vanilla/node_modules/vite/bin/vite.js",
        "examples/vanilla",
        "--port",
        "5301",
        "--strictPort"
      ],
      "port": 5301
    },
    {
      "name": "example-react",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "examples/react-vite/node_modules/vite/bin/vite.js",
        "examples/react-vite",
        "--port",
        "5302",
        "--strictPort"
      ],
      "port": 5302
    },
    {
      "name": "example-next",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "examples/next/node_modules/next/dist/bin/next",
        "dev",
        "examples/next",
        "-p",
        "5303"
      ],
      "port": 5303
    },
    {
      "name": "example-vue",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "examples/vue/node_modules/vite/bin/vite.js",
        "examples/vue",
        "--port",
        "5304",
        "--strictPort"
      ],
      "port": 5304
    },
    {
      "name": "example-svelte",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "examples/svelte/node_modules/vite/bin/vite.js",
        "dev",
        "examples/svelte",
        "--port",
        "5305",
        "--strictPort"
      ],
      "port": 5305
    },
    {
      "name": "example-react-full",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "examples/react-full/node_modules/vite/bin/vite.js",
        "examples/react-full",
        "--port",
        "5306",
        "--strictPort"
      ],
      "port": 5306
    },
    {
      "name": "example-next-shadcn",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "examples/next-shadcn/node_modules/next/dist/bin/next",
        "dev",
        "examples/next-shadcn",
        "-p",
        "5307"
      ],
      "port": 5307
    }
  ]
}
