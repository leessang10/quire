{
  "name": "quire",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "spikes/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @quire/playground",
    "build": "npm run build -w @quire/playground",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p spikes/crdt/tsconfig.json && tsc -p spikes/shaping/tsconfig.json",
    "bench": "vitest run --config vitest.bench.config.ts",
    "bench:browser": "node scripts/bench.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "golden": "node scripts/golden.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
